VITE_PAYWALL_API_BASE_URL=http://localhost:3010
VITE_APP_VERSION=0.1.0

# Rust compile-time env var used by src-tauri.
# `npm run tauri ...` will load this from `.env`/`paywall-api/.env` automatically and can derive
# it from `ENTITLEMENT_SIGNING_PRIVATE_KEY_PEM` for local development.
# If you omit it entirely in local development, Trackr falls back to the bundled demo entitlement key.
# TRACKR_PAYWALL_PUBLIC_KEY_DER_BASE64=MCowBQYDK2VwAyEA...

# Ensure Tauri applies Finder styling (background, icon positions) to the DMG.
# Set to true for local builds; CI builds may need this if the bundler skips AppleScript.
# TAURI_BUNDLER_DMG_IGNORE_CI=true
