{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trackr",
  "version": "1.0.3",
  "identifier": "com.rohansingh.trackr",
  "build": {
    "beforeDevCommand": "node ./scripts/run-with-app-version.mjs dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node ./scripts/validate-release-env.mjs && node ./scripts/run-with-app-version.mjs build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Trackr",
        "width": 1024,
        "height": 760,
        "minWidth": 900,
        "minHeight": 640,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "'self' ipc: http://ipc.localhost https://www.trackr.bar https://github.com https://objects.githubusercontent.com",
        "font-src": "'self' asset: data:",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": "v1Compatible",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "Developer ID Application: Aura Technologies LLC (U.S.) (U6S7MR27AK)",
      "hardenedRuntime": true,
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/auratechnologiesllc/Trackr/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA5ODJBQzQ2QTZCMjA1RUIKUldUckJiS21ScXlDQ2F1Y2E1b3RUNUpUWWtrbUxmWkdhWWpxcXpaRWd5KzBibHZyTElHU0grcW8K"
    }
  }
}
